{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/mytype", "destination": "/index.html" },
    { "source": "/mytype.html", "destination": "/index.html" },
    { "source": "/((?!icons|covers|data|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(sw.js|manifest.json)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
